# Normalize line endings: LF in the repository and in working copies, on every OS.
* text=auto eol=lf

# Windows-specific files keep CRLF.
*.sln   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never convert or diff as text.
*.ico   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.woff  binary
*.woff2 binary
*.docx  binary
*.pdf   binary
