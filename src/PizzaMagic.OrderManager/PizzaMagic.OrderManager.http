@PizzaMagic.OrderManager_HostAddress = http://localhost:5100

### The default restaurant's menu, with server-computed topping prices
GET {{PizzaMagic.OrderManager_HostAddress}}/api/v1/menu
Accept: application/json

### P9: 2 x Large + pepperoni + bacon, ILOVEPIZZA, 15% tip -> $31.48
POST {{PizzaMagic.OrderManager_HostAddress}}/api/v1/quotes
Content-Type: application/json

{
  "lineItems": [ { "kind": "Pizza", "sizeCode": "LARGE", "quantity": 2,
                   "toppings": [ { "code": "PEPPERONI" }, { "code": "BACON" } ] } ],
  "promoCodes": [ "ILOVEPIZZA" ],
  "tip": { "mode": "Percent", "value": "15" }
}

### P24: a conflicting second code is Rejected; total unchanged ($31.48)
POST {{PizzaMagic.OrderManager_HostAddress}}/api/v1/quotes
Content-Type: application/json

{
  "lineItems": [ { "kind": "Pizza", "sizeCode": "LARGE", "quantity": 2,
                   "toppings": [ { "code": "PEPPERONI" }, { "code": "BACON" } ] } ],
  "promoCodes": [ "ILOVEPIZZA", "SAVE5" ],
  "tip": { "mode": "Percent", "value": "15" }
}

### Dollar tip with its effective rate: $3.00 (10.96%)
POST {{PizzaMagic.OrderManager_HostAddress}}/api/v1/quotes
Content-Type: application/json

{
  "lineItems": [ { "kind": "Pizza", "sizeCode": "LARGE", "quantity": 2,
                   "toppings": [ { "code": "PEPPERONI" }, { "code": "BACON" } ] } ],
  "promoCodes": [ "ILOVEPIZZA" ],
  "tip": { "mode": "Amount", "value": "3.00" }
}

### Field errors: 422 with JSON paths
POST {{PizzaMagic.OrderManager_HostAddress}}/api/v1/quotes
Content-Type: application/json

{
  "lineItems": [ { "kind": "Pizza", "sizeCode": "LARGE", "quantity": 0,
                   "toppings": [ { "code": "PEPPERONI", "portion": "LEFT" } ] } ],
  "tip": { "mode": "Amount", "value": "1.234" }
}

### Submit P9 (Idempotency-Key required; repeat the same request to see the replay: same order, Idempotent-Replayed: true)
# @name submit
POST {{PizzaMagic.OrderManager_HostAddress}}/api/v1/orders
Content-Type: application/json
Idempotency-Key: try-it-1

{
  "lineItems": [ { "kind": "Pizza", "sizeCode": "LARGE", "quantity": 2,
                   "toppings": [ { "code": "PEPPERONI" }, { "code": "BACON" } ] } ],
  "promoCodes": [ "ILOVEPIZZA" ],
  "tip": { "mode": "Percent", "value": "15" },
  "expectedTotalCents": 3148,
  "customerName": "Dana"
}

### The stored order (never re-priced)
GET {{PizzaMagic.OrderManager_HostAddress}}/api/v1/orders/{{submit.response.body.$.orderId}}

### Light status for polling
GET {{PizzaMagic.OrderManager_HostAddress}}/api/v1/orders/{{submit.response.body.$.orderId}}/status

### Written description (text/plain)
GET {{PizzaMagic.OrderManager_HostAddress}}/api/v1/orders/{{submit.response.body.$.orderId}}/description

### Stale expectedTotalCents: 409 price-changed with the current quote; no order is created
POST {{PizzaMagic.OrderManager_HostAddress}}/api/v1/orders
Content-Type: application/json
Idempotency-Key: try-it-2

{
  "lineItems": [ { "kind": "Pizza", "sizeCode": "LARGE", "quantity": 2,
                   "toppings": [ { "code": "PEPPERONI" }, { "code": "BACON" } ] } ],
  "promoCodes": [ "ILOVEPIZZA" ],
  "tip": { "mode": "Percent", "value": "15" },
  "expectedTotalCents": 3100
}
