<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PizzaMagic.Domain\PizzaMagic.Domain.csproj" />
    <ProjectReference Include="..\PizzaMagic.Contracts\PizzaMagic.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema is hand-written SQL (plan section 4.3), run verbatim by the InitialSchema migration. -->
    <EmbeddedResource Include="Data\Schema\*.sql" />
    <!-- Seed scripts live in the repository's data/ folder and are applied at startup in name order (section 2.12). -->
    <Content Include="..\..\data\seed\*.sql" LinkBase="data\seed" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
