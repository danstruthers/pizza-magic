@model PizzaMagic.Web.Models.BuilderViewModel
@{
    ViewData["Title"] = "Build your order";
    var menu = Model.Menu;
}

@if (menu is null)
{
    <div class="alert alert-warning" role="alert">
        The menu is unavailable right now. <a href="/">Try again</a> in a moment.
    </div>
    return;
}

@{
    var locked = Model.Cart.PendingTicket is not null;
}

@if (locked)
{
    <div class="alert alert-warning" role="alert">
        <strong>We couldn't confirm your order.</strong> Your cart is saved and locked until we know whether it went through.
        <a href="/Checkout" class="alert-link">Check and try again</a>
    </div>
}
else if (Model.Cart.EditingOrderId is { } editing)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2" role="status">
        <span>You're changing order <a href="/Orders/@editing" class="alert-link font-monospace">@editing</a>. Review your changes to save them.</span>
        <form method="post" action="/Builder/StartOver" class="ms-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">Start a new order instead</button>
        </form>
    </div>
}
else if (Model.Cart.LastPlacedOrderId is { } placed)
{
    <div class="alert alert-success" role="status">
        Your order @placed.ToString()[..8] was placed. <a href="/Orders/@placed" class="alert-link">See its status</a>
    </div>
}

<div id="builder" data-menu="@Model.MenuJson" data-cart="@Model.CartJson">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8" inert="@(locked ? "inert" : null)">
            <h1 class="h3">Build your order</h1>
            <p class="text-muted">Choose a size and toppings for each pizza. Your total updates as you go.</p>

            <div id="lines" class="d-flex flex-column gap-3"></div>
            <button type="button" id="add-line" class="btn btn-outline-primary mt-3">+ Add a pizza</button>

            <section class="mt-4">
                <h2 class="h5">Promo codes</h2>
                <div class="input-group" style="max-width: 24rem">
                    <input id="promo-input" class="form-control" placeholder="e.g. ILOVEPIZZA" maxlength="32" autocomplete="off" aria-label="Promo code" />
                    <button type="button" id="promo-apply" class="btn btn-outline-secondary">Apply</button>
                </div>
                <ul id="promo-chips" class="list-unstyled mt-2 mb-0" aria-live="polite">
                    <li class="small text-muted">No promo codes applied.</li>
                </ul>
                <div id="promo-notices" class="small text-danger mt-1" aria-live="polite"></div>
            </section>

            <section class="mt-4">
                <h2 class="h5">Tip</h2>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary tip-none">No tip</button>
                    @foreach (var preset in menu.Policy.TipPresetsPpm)
                    {
                        <button type="button" class="btn btn-outline-secondary tip-preset" aria-pressed="false" data-percent="@((preset / 10000m).ToString(System.Globalization.CultureInfo.InvariantCulture))">@BuilderViewModel.Percent(preset)</button>
                    }
                    <select id="tip-mode" class="form-select w-auto" aria-label="Tip type">
                        <option value="Percent">%</option>
                        <option value="Amount">$</option>
                    </select>
                    <input id="tip-value" class="form-control w-auto" inputmode="decimal" placeholder="Custom" aria-label="Tip value" size="8" />
                </div>
                <div class="small text-danger mt-1" data-error-for="tip.value"></div>
            </section>
        </div>

        <aside class="col-lg-4">
            <div id="total-panel" class="card shadow-sm position-sticky" style="top: 1rem">
                <div class="card-body">
                    <h2 class="h5 card-title">Your order</h2>
                    <div id="total-status" class="small text-muted mb-2" aria-live="polite">Add a pizza to see your total.</div>
                    <dl class="row mb-0 small" id="totals" aria-live="polite" aria-atomic="true">
                        <dt class="col-6 fw-normal">Subtotal</dt><dd class="col-6 text-end" data-total="subtotal">—</dd>
                        <dt class="col-6 fw-normal">Discounts</dt><dd class="col-6 text-end" data-total="discount">—</dd>
                        <dd class="col-12 small text-success mb-1" id="discount-lines"></dd>
                        <dt class="col-6 fw-normal">Tax</dt><dd class="col-6 text-end" data-total="tax">—</dd>
                        <dt class="col-6 fw-normal">Tip</dt><dd class="col-6 text-end" data-total="tip">—</dd>
                        <dt class="col-6 fs-5">Total</dt><dd class="col-6 text-end fs-5 fw-bold" data-total="total">—</dd>
                    </dl>
                    <div id="reasons" class="small text-warning-emphasis mt-2"></div>
                    @* A real button: disabled until the current quote says the order can be placed (mouse and keyboard). *@
                    <form method="get" action="/Checkout" class="mt-3">
                        <button type="submit" id="review" class="btn btn-primary w-100" disabled>Review order</button>
                    </form>
                    <button type="button" id="describe" class="btn btn-link w-100 mt-1">Describe my order</button>
                    <pre id="description" class="small bg-light p-2 mt-2 d-none" style="white-space: pre-wrap"></pre>
                </div>
            </div>
        </aside>
    </div>
</div>

<template id="line-template">
    <div class="card line">
        <div class="card-body">
            <h2 class="h6 line-title">Pizza</h2>
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    @* The script gives each line's controls ids and points these labels at them. *@
                    <label class="form-label small mb-0 size-label">Size</label>
                    <select class="form-select size" data-field="sizeCode">
                        @foreach (var size in menu.Sizes)
                        {
                            <option value="@size.Code">@size.Name — @BuilderViewModel.Money(size.PriceCents)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-0 quantity-label">Quantity</label>
                    <input type="number" class="form-control quantity" data-field="quantity" min="1" max="@menu.Policy.MaxLineQuantity" value="1" style="width: 6rem" />
                </div>
                <button type="button" class="btn btn-outline-danger ms-auto remove-line">Remove</button>
            </div>
            <div class="small text-danger line-errors"></div>
            @foreach (var tier in menu.ToppingTiers)
            {
                <fieldset class="mt-3">
                    <legend class="h6 mb-1">@tier.Name toppings</legend>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var topping in tier.Toppings)
                        {
                            <div class="d-flex align-items-center gap-1">
                                <label class="form-check-label">
                                    <input type="checkbox" class="form-check-input topping" value="@topping.Code" data-prices="@BuilderViewModel.WholePricesJson(topping)" />
                                    @topping.Name <span class="text-muted topping-price"></span>
                                </label>
                                @if (topping.MaxMultiplier > 1)
                                {
                                    <select class="form-select form-select-sm w-auto multiplier" data-for="@topping.Code" aria-label="@topping.Name amount" disabled>
                                        @for (var amount = 1; amount <= topping.MaxMultiplier; amount++)
                                        {
                                            <option value="@amount">@BuilderViewModel.Amount(amount)</option>
                                        }
                                    </select>
                                }
                            </div>
                        }
                    </div>
                </fieldset>
            }
        </div>
    </div>
</template>

@section Scripts {
    <script type="module" src="~/js/order-builder.js" asp-append-version="true"></script>
}
