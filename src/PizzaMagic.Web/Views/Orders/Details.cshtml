@model PizzaMagic.Web.Models.OrderDetailsViewModel
@{
    var order = Model.Order;
    var pricing = order.Pricing;
    ViewData["Title"] = "Your order";
    var url = $"/Orders/{order.OrderId}";
    var isFinal = order.Status is "Delivered" or "Cancelled";
}

@if (!isFinal)
{
    <noscript><meta http-equiv="refresh" content="15" /></noscript>
}

<h1 class="h3">Your order</h1>
<p class="mb-1">Order number <strong class="font-monospace user-select-all">@order.OrderId</strong></p>
<p class="small text-muted">Save this page's link to check on your order from any device.</p>

@if (Model.Notice is not null)
{
    <div class="alert alert-info" role="status">@Model.Notice</div>
}

<div id="order-status" class="card mb-4" data-status-url="@url/Status" data-status="@order.Status">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div>
            <div class="small text-muted">Status</div>
            <div class="fs-4 fw-bold" data-field="statusDisplay">@order.StatusDisplay</div>
            <div class="small text-muted">since <span data-field="statusChangedAt">@Display.Time(order.StatusChangedAtLocal, order.StatusChangedAt)</span></div>
        </div>
        <div class="ms-auto d-flex gap-2">
            @if (Model.CanUpdate)
            {
                <form method="post" action="@url/Edit" data-action="update">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary">Change order</button>
                </form>
            }
            @if (Model.CanCancel)
            {
                <form method="post" action="@url/Cancel" data-action="cancel" onsubmit="return confirm('Cancel this order?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Cancel order</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <table class="table">
            <tbody>
                @foreach (var line in pricing.LineItems)
                {
                    <tr><td>@line.Description</td><td class="text-end">@Display.Money(line.LineTotalCents)</td></tr>
                }
                @foreach (var promo in pricing.Promotions.Where(p => p.DiscountCents > 0))
                {
                    <tr class="text-success"><td>@promo.Code</td><td class="text-end">−@Display.Money(promo.DiscountCents)</td></tr>
                }
            </tbody>
        </table>
        <h2 class="h6">Order description</h2>
        <pre class="small bg-light p-2" style="white-space: pre-wrap">@order.Description</pre>
    </div>
    <aside class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-6 fw-normal">Subtotal</dt><dd class="col-6 text-end">@Display.Money(pricing.SubtotalCents)</dd>
                    <dt class="col-6 fw-normal">Discounts</dt><dd class="col-6 text-end">−@Display.Money(pricing.DiscountCents)</dd>
                    <dt class="col-6 fw-normal">Tax</dt><dd class="col-6 text-end">@Display.Money(pricing.TaxCents)</dd>
                    <dt class="col-6 fw-normal">Tip</dt><dd class="col-6 text-end">@Display.Tip(pricing.Tip)</dd>
                    <dt class="col-6 fs-5">Total</dt><dd class="col-6 text-end fs-5 fw-bold">@Display.Money(pricing.TotalCents)</dd>
                </dl>
                <p class="small text-muted mt-2 mb-0">Placed at @Display.Time(order.CreatedAtLocal, order.CreatedAt). Pay when you pick up your order.</p>
            </div>
        </div>
    </aside>
</div>

<a href="/Orders" class="btn btn-link px-0 mt-3">Your recent orders</a>

@section Scripts {
    <script type="module" src="~/js/order-details.js" asp-append-version="true"></script>
}
